# URL base da API Backend (em dev o Vite faz proxy de /api/v1 para http://localhost:3001/api/v1)
VITE_API_URL=/api/v1

# Domínio do Site Institucional (Landing Page Pública)
VITE_PUBLIC_DOMAIN=www.vetlifelab.com.br
VITE_PUBLIC_SITE_URL=https://www.vetlifelab.com.br

# Domínio do Dashboard e Sistema Laboratorial (Admin, Biomédico, Veterinário e Consulta de Laudos)
VITE_APP_DOMAIN=app.vetlifelab.com.br
VITE_APP_SYSTEM_URL=https://app.vetlifelab.com.br
