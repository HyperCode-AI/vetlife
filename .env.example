# =============================================================================
# PLATAFORMA VETLIFE (vetlifelab.com.br) — ENVIRONMENT VARIABLES (.env.example)
# =============================================================================

# --- AMBIENTE E SERVIDOR BACKEND ---
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173,https://vetlifelab.com.br,https://www.vetlifelab.com.br,https://app.vetlifelab.com.br

# --- SEGURANÇA E AUTENTICAÇÃO JWT ---
JWT_SECRET=vetlife-super-secret-jwt-key-2026-change-in-production
JWT_EXPIRES_IN=24h

# --- SUPABASE (POSTGRESQL & AUTH / STORAGE) ---
# Nota: Caso SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY não sejam preenchidos,
# o backend ativa automaticamente o HybridDataStore em memória pré-populado
# com os dados do supabase/seed.sql para desenvolvimento/demo imediato.
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua-chave-anon-publica-do-supabase
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-secreta-do-supabase

# --- FRONTEND & MULTI-DOMÍNIO (VITE) ---
VITE_API_URL=/api/v1
VITE_APP_NAME="VetLife Laboratório Veterinário"
VITE_PUBLIC_SITE_URL=https://www.vetlifelab.com.br
VITE_SYSTEM_APP_URL=https://app.vetlifelab.com.br

# --- VERCEL BLOB STORAGE (LAUDOS PDF ONLINE) ---
BLOB_READ_WRITE_TOKEN=
